{
    "name": "two-performant/business-league-marketing",
    "description": "Magento 2 plugin for injecting tracking scripts and iframe",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "files": [
        "registration.php"
        ],
        "psr-4": {
        "TwoPerformant\\BusinessLeagueMarketing\\": ""
        }
    },
    "require": {
        "php": "~7.1.3 || ~7.2.0 || ~7.3.0 || ~7.4.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0" 
    },
    "require-dev": {
        "magento/magento-coding-standard": "^38.0",
        "phpcompatibility/php-compatibility": "*"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/phpcs --runtime-set ignore_warnings_on_exit 1"
        ],
        "post-install-cmd": [
        "phpcs --config-set installed_paths ../../magento/magento-coding-standard/,../../magento/php-compatibility-fork"
        ],
        "post-update-cmd": [
            "phpcs --config-set installed_paths ../../magento/magento-coding-standard/,../../magento/php-compatibility-fork"
        ]
    }
}
